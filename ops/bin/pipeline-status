#!/usr/bin/env bash
# pipeline-status — quick project health dashboard.
# Reads ops/cron/archon-projects.txt for the canonical project list.
# Usage: pipeline-status [repo-slug ...]
set -uo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECTS_FILE="$SCRIPT_DIR/../cron/archon-projects.txt"
SWEEP_STATUS_FILE="$HOME/.archon/sweep-state/last-sweep"   # written by ops/cron/sweep-audits.sh
# The factory's GitHub identity, probed the way pipeline-health does
# (as the archon user when ARCHON_RUN_AS is archon or drain).
# shellcheck source=../cron/lib/run-as.sh
source "$SCRIPT_DIR/../cron/lib/run-as.sh"
# shellcheck source=../cron/lib/gh-factory.sh
source "$SCRIPT_DIR/../cron/lib/gh-factory.sh"
# issue-pickup's record of its reads of Lachesis next_issue.
# shellcheck source=../cron/lib/lachesis.sh
source "$SCRIPT_DIR/../cron/lib/lachesis.sh"
# pipeline-health's per-repo stall markers (stall_note), parked drafts
# whose review said not ready (deadline_kind_note), and the ops PRs held for
# ops-pr-review.sh (deadline_current_items).
# shellcheck source=../cron/lib/deadlines.sh
source "$SCRIPT_DIR/../cron/lib/deadlines.sh"
OWNER="alexsiri7"

# Colours
BOLD='\033[1m'; RESET='\033[0m'
RED='\033[0;31m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'; DIM='\033[2m'

# --- Load project list ---
if [ $# -gt 0 ]; then
    PROJECTS=("$@")
else
    mapfile -t PROJECTS < <(grep -v '^\s*#' "$PROJECTS_FILE" | grep -v '^\s*$' | sed 's/#.*//' | sed 's/[[:space:]]//g')
fi

# --- Helpers ---
label_bucket() {
    # Summarise issue labels into a short tag
    local labels="$1"
    if echo "$labels" | grep -qi "human-needed";       then echo "human-needed"; return; fi
    if echo "$labels" | grep -qi "factory-gap";        then echo "factory-gap";  return; fi
    if echo "$labels" | grep -qi "archon:in-progress"; then echo "archon:wip";   return; fi
    if echo "$labels" | grep -qi "archon:queued";      then echo "archon:queued";return; fi
    if echo "$labels" | grep -qi "archon:skipped";     then echo "archon:skipped";return; fi
    echo "open"
}

ci_status() {
    local repo="$1"
    local result
    # Exclude scheduled monitoring/health workflows (uptime, health, disk, resource, backup checks).
    # Only count push/pull_request-triggered runs as real CI.
    result=$(gh api "repos/$OWNER/$repo/commits/HEAD/check-runs" \
        --jq '[.check_runs[] | select(.status=="completed")
              | select(.name | test("health|uptime|monitor|disk|backup|resource"; "i") | not)]
              | if length==0 then "none"
                elif (map(select(.conclusion!="success" and .conclusion!="skipped" and .conclusion!="neutral")) | length) > 0 then "fail"
                else "pass" end' 2>/dev/null || echo "err")
    echo "$result"
}

sweep_status() {
    [ -r "$SWEEP_STATUS_FILE" ] || { printf "${DIM}no sweep recorded${RESET}"; return; }
    local key val last_run=0 outcome="" reason="" sweep="" repo="" account=""
    while IFS='=' read -r key val; do
        case "$key" in
            last_run) last_run="$val" ;; outcome) outcome="$val" ;; reason) reason="$val" ;;
            sweep) sweep="$val" ;; repo) repo="$val" ;; account) account="$val" ;;
        esac
    done < "$SWEEP_STATUS_FILE"
    local when; when=$(date -d "@$last_run" '+%F %H:%M' 2>/dev/null || echo "?")
    if [ "$outcome" = ok ]; then
        printf "${GREEN}OK${RESET}"
    else
        printf "${RED}FAILED (%s)${RESET}" "${reason:-unknown}"
    fi
    printf "  %s on %s, %s%s" "$sweep" "$repo" "$when" "${account:+, account ${account##*/}}"
}

gh_factory_status() {
    gh_factory_probe
    case "$GH_FACTORY_STATE" in
        ok)      printf "${GREEN}OK${RESET}  %s (%s)" "$GH_FACTORY_DETAIL" "$(gh_factory_who)" ;;
        blocked) printf "${RED}BLOCKED${RESET}  %s (%s) — factory runs cannot open PRs" "$GH_FACTORY_DETAIL" "$(gh_factory_who)" ;;
        *)       printf "${YELLOW}unknown${RESET}  %s" "$GH_FACTORY_DETAIL" ;;
    esac
}

issue_pickup_status() {
    if lachesis_next_failing; then
        printf "${RED}FAILING${RESET}  %s — no issue is picked up" "$LACHESIS_NEXT_PROBLEM"
        return
    fi
    local last_ok failures
    last_ok=$(lachesis_next_status_get last_ok)
    failures=$(lachesis_next_status_get failures)
    if [ -z "$last_ok" ]; then
        printf "${DIM}no next_issue read recorded${RESET}"
        return
    fi
    if [ "${failures:-0}" -gt 0 ]; then
        printf "${YELLOW}last tick failed${RESET}  Lachesis next_issue unread on %s tick(s) in a row" "$failures"
    else
        printf "${GREEN}OK${RESET}"
    fi
    if [ "$last_ok" -gt 0 ]; then
        printf "  next_issue last read %s" "$(date -d "@$last_ok" '+%F %H:%M' 2>/dev/null || echo "?")"
    fi
}

# ops_review_status — "0", or "N (oldest Xh)" for the current ops-merge marks.
ops_review_status() {
    local items n oldest
    items=$(deadline_current_items ops-merge)
    [ -n "$items" ] || { echo 0; return; }
    n=$(wc -l <<<"$items")
    oldest=$(awk 'NR == 1 || $4 < m { m = $4 } END { print m }' <<<"$items")
    echo "$n (oldest $(( ($(deadline_now) - oldest) / 3600 ))h)"
}

# --- Header ---
echo ""
printf "${BOLD}%-22s  %4s  %6s  %5s  %s${RESET}\n" "REPO" "PRs" "ISSUES" "CI" "NOTES"
printf '%s\n' "──────────────────────────────────────────────────────────────"

any_stuck=0
any_stalled=0

for REPO in "${PROJECTS[@]}"; do
    # Open PRs
    pr_count=$(gh pr list --repo "$OWNER/$REPO" --state open --limit 50 --json number \
        --jq 'length' 2>/dev/null || echo "?")

    # Open issues — group by label bucket
    issue_json=$(gh issue list --repo "$OWNER/$REPO" --state open --limit 100 \
        --json number,labels 2>/dev/null || echo "[]")
    issue_count=$(echo "$issue_json" | jq 'length' 2>/dev/null || echo "?")

    # Bucket counts for notes
    human_needed=$(echo "$issue_json" | jq '[.[] | select(.labels[].name=="human-needed")] | length' 2>/dev/null || echo 0)
    factory_gap=$(echo  "$issue_json" | jq '[.[] | select(.labels[].name=="factory-gap")]  | length' 2>/dev/null || echo 0)
    archon_wip=$(echo   "$issue_json" | jq '[.[] | select(.labels[].name=="archon:in-progress")] | length' 2>/dev/null || echo 0)

    # CI on main
    ci=$(ci_status "$REPO")
    case "$ci" in
        pass) ci_str="${GREEN}pass${RESET}" ;;
        fail) ci_str="${RED}FAIL${RESET}";  any_stuck=1 ;;
        none) ci_str="${DIM}none${RESET}" ;;
        *)    ci_str="${DIM} ?  ${RESET}" ;;
    esac

    # Notes column
    notes=""
    [ "$human_needed" -gt 0 ] 2>/dev/null && notes+="${YELLOW}human-needed:${human_needed}${RESET} "
    [ "$factory_gap"  -gt 0 ] 2>/dev/null && notes+="factory-gap:${factory_gap} "
    [ "$archon_wip"   -gt 0 ] 2>/dev/null && notes+="wip:${archon_wip} "
    [ "$pr_count" -gt 3 ]     2>/dev/null && notes+="${YELLOW}${pr_count} PRs${RESET} "
    not_ready=$(deadline_kind_note "$REPO" review-not-ready)
    [ -n "$not_ready" ] && notes+="${YELLOW}review-not-ready: ${not_ready}${RESET} "
    stall=$(stall_note "$REPO")
    if [ -n "$stall" ]; then
        notes+="${RED}${stall}${RESET} "
        any_stalled=1
    fi

    printf "%-22s  %4s  %6s  " "$REPO" "$pr_count" "$issue_count"
    printf "${ci_str}  ${notes}\n"
done

echo ""
printf "last sweep: %s\n" "$(sweep_status)"
printf "factory GitHub: %s\n" "$(gh_factory_status)"
printf "issue pickup: %s\n" "$(issue_pickup_status)"
printf "ops PRs awaiting review: %s\n\n" "$(ops_review_status)"
if lachesis_next_failing; then
    printf "${RED}Issue pickup is failing: %s.${RESET}\n\n" "$LACHESIS_NEXT_PROBLEM"
fi
if [ "$any_stalled" -eq 1 ]; then
    printf '%bAt least one repo has open work and merged nothing in 24h — check above.%b\n\n' "$RED" "$RESET"
fi
if [ "$any_stuck" -eq 1 ]; then
    printf "${RED}CI red on main in at least one project — check above.${RESET}\n\n"
fi
