#!/usr/bin/env bash
# `gh` for the factory user: every issue or PR conversation comment an archon
# session posts ends with <!-- lachesis:automated -->, then the real gh runs.
# Factory runs post as the owner, so without the line Lachesis takes an agent's
# own comment on a question-blocked issue for the author's answer (lachesis
# #386, interstellarai.net#298). ops/cron's scripts stamp their own bodies; this
# covers the comments agents compose themselves.
#
# Installed root-owned at /usr/local/lib/archon-user/gh-shim/gh by install.sh;
# that directory holds only this file and is first on the PATH archon_env (in
# archon-as-archon) and archon-serve.service give every factory session.
#
# Stamped: `issue|pr comment` (the body moves to --body-file -), the -c/--comment
# of `issue|pr close|reopen`, and `api` POST/PATCH to repos/{o}/{r}/issues/{n}/comments
# or repos/{o}/{r}/issues/comments/{id} (-f/-F body=, or --input JSON's .body).
# A GraphQL addComment/updateIssueComment is refused (exit 2) rather than
# rewritten, whether its query comes from -f/-F query= or --input; so is an
# `issue|pr comment` whose body comes from --attach (gh can append unreferenced
# attachments after the marker) or -e/--editor (no body this wrapper can read
# and stamp). Everything else, and any body source that cannot be read, goes to
# the real gh unchanged.
#
# set -u, not -e: the wrapper must never fail where the real gh would succeed.
set -u
MARKER='<!-- lachesis:automated -->'

real=""
IFS=: read -r -a _dirs <<<"${PATH:-}"
for d in "${_dirs[@]}"; do
    [ -n "$d" ] || continue
    c="$d/gh"
    if [ -f "$c" ] && [ -x "$c" ] && ! [ "$c" -ef "${BASH_SOURCE[0]}" ]; then real="$c"; break; fi
done
[ -n "$real" ] || { echo "gh (factory wrapper): no gh executable found on PATH" >&2; exit 127; }
orig=("$@")

# Strip trailing whitespace, append the marker unless it already ends the
# text. An empty body stays empty so the real gh still refuses it. Delegates
# to jq's Unicode-aware \s (bash's [[:space:]] never matches a multi-byte
# codepoint like a non-breaking space, in any locale) so every caller agrees
# on what counts as already-stamped.
stamp() {
    local t="$1"
    printf '%s' "$(jq -nr --arg t "$t" --arg m "$MARKER" \
        '($t | sub("\\s+$"; "")) as $s | if $s == "" or ($s | endswith($m)) then $s else $s + "\n\n" + $m end')"
}
read_src() { if [ "$1" = - ]; then cat; else cat -- "$1"; fi; }
passthrough() { exec "$real" "${orig[@]}"; }
refuse() { echo "gh (factory wrapper): $1 (interstellarai.net#298)" >&2; exit 2; }

# dispatch_action <args after "issue"/"pr">: the action subcommand word
# (comment, close, ...), skipping a persistent -R/--repo flag that gh accepts
# before it, e.g. `gh issue -R o/r comment 12 ...`.
dispatch_action() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -R|--repo) [ $# -ge 2 ] || return; shift 2 ;;
            --repo=*|-R?*) shift ;;
            *) printf '%s' "$1"; return ;;
        esac
    done
}

comment_cmd() {
    local out=() tail=() body="" found=0 have_b=0 have_f=0 b
    local a=("$@") i=0
    while [ "$i" -lt "${#a[@]}" ]; do
        case "${a[$i]}" in
            -b|--body) have_b=1; i=$((i + 2)) ;;
            --body=*|-b?*) have_b=1; i=$((i + 1)) ;;
            -F|--body-file) have_f=1; i=$((i + 2)) ;;
            --body-file=*|-F?*) have_f=1; i=$((i + 1)) ;;
            --) break ;;
            *) i=$((i + 1)) ;;
        esac
    done
    # Real gh refuses -b/--body together with -F/--body-file locally (exit 1,
    # nothing posted); forward the original flags unmodified so it still does,
    # instead of silently picking whichever this wrapper parsed last.
    [ "$have_b" = 1 ] && [ "$have_f" = 1 ] && passthrough
    set -- "${a[@]}"
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--body) [ $# -ge 2 ] || passthrough; body="$2"; found=1; shift 2 ;;
            --body=*) body="${1#--body=}"; found=1; shift ;;
            -b?*) body="${1#-b}"; found=1; shift ;;
            -F|--body-file) [ $# -ge 2 ] || passthrough; b=$(read_src "$2") || passthrough; body="$b"; found=1; shift 2 ;;
            --body-file=*) b=$(read_src "${1#--body-file=}") || passthrough; body="$b"; found=1; shift ;;
            -F?*) b=$(read_src "${1#-F}") || passthrough; body="$b"; found=1; shift ;;
            --attach|--attach=*) refuse "attach files via a second, already-stamped comment -- gh appends unreferenced --attach content after $MARKER" ;;
            -e|--editor) refuse "pass the body with -b/--body or --body-file so it can be stamped with $MARKER, not -e/--editor" ;;
            --) tail=("$@"); break ;;
            *) out+=("$1"); shift ;;
        esac
    done
    [ "$found" = 1 ] || passthrough
    exec "$real" "${out[@]}" --body-file - "${tail[@]}" < <(stamp "$body")
}

close_cmd() {
    local out=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--comment) [ $# -ge 2 ] || break; out+=("$1" "$(stamp "$2")"); shift 2 ;;
            --comment=*) out+=("--comment=$(stamp "${1#--comment=}")"); shift ;;
            -c?*) out+=(-c "$(stamp "${1#-c}")"); shift ;;
            --) break ;;
            *) out+=("$1"); shift ;;
        esac
    done
    exec "$real" "${out[@]}" "$@"
}

# split_opt <arg> [<next>]: when <arg> is one of gh api's value-taking flags,
# OPT is its canonical name (-X, -f, -F, --input, ...) and VAL its value, and
# NUSED is how many words it took (1 for --flag=v and -fv, 2 for --flag v).
split_opt() {
    OPT="" VAL="" NUSED=1
    case "$1" in
        -X|--method|-f|--raw-field|-F|--field|-H|--header|-q|--jq|-t|--template|--hostname|--cache|-p|--preview|--input)
            OPT="$1" VAL="${2-}" NUSED=2 ;;
        --method=*|--raw-field=*|--field=*|--header=*|--jq=*|--template=*|--hostname=*|--cache=*|--preview=*|--input=*)
            OPT="${1%%=*}" VAL="${1#*=}" ;;
        -[XfFHqtp]?*) OPT="${1:0:2}" VAL="${1:2}" ;;
    esac
    case "$OPT" in --method) OPT=-X ;; --raw-field) OPT=-f ;; --field) OPT=-F ;; esac
}

# graphql_cmd <args>: refuses a comment mutation wherever its query comes from
# (-f/-F query=, -F query=@<src>, --input <src>). A source read for the check
# (a pipe or process substitution cannot be read twice) goes on to the real gh
# as text: -F query=@<src> as -f query=, --input <src> on stdin.
graphql_cmd() {
    local query="" q input="" use_stdin=0 args=()
    while [ $# -gt 0 ]; do
        split_opt "$1" "${2-}"
        if [[ "$OPT" == -f || "$OPT" == -F ]] && [[ "$VAL" == query=* ]]; then
            q="${VAL#query=}"
            if [ "$OPT" = -F ] && [[ "$q" == @* ]]; then
                q=$(read_src "${q#@}") || passthrough
                args+=(-f "query=$q")
            else
                args+=("${@:1:NUSED}")
            fi
            query="$query$q"
        elif [ "$OPT" = --input ]; then
            input=$(read_src "$VAL") || passthrough
            q=$(jq -r '.query // empty' <<<"$input" 2>/dev/null) || q="$input"
            query="$query$q"
            args+=(--input -); use_stdin=1
        else
            args+=("${@:1:NUSED}")
        fi
        shift
        [ "$NUSED" = 2 ] && [ $# -gt 0 ] && shift
    done
    if [[ "$query" =~ addComment|updateIssueComment ]]; then
        refuse "post issue and PR comments with 'gh issue comment' / 'gh pr comment' so they carry $MARKER"
    fi
    [ "$use_stdin" = 1 ] && exec "$real" api "${args[@]}" < <(printf '%s' "$input")
    exec "$real" api "${args[@]}"
}

# api_path <endpoint>: the path gh api requests, without a scheme://host, a
# query string or fragment, or leading and trailing slashes. gh sends a full
# URL as is and appends any other path to https://api.github.com/, so /graphql
# and https://api.github.com/graphql reach the same endpoint as graphql.
api_path() {
    local p="$1"
    p="${p%%[?#]*}"
    [[ "$p" == *://* ]] && { p="${p#*://}"; p="${p#*/}"; }
    while [[ "$p" == /* ]]; do p="${p#/}"; done
    while [[ "$p" == */ ]]; do p="${p%/}"; done
    printf '%s' "$p"
}

api_cmd() {
    local endpoint="" method="" fields=0 args=() json="" stamped use_stdin=0 v
    shift
    # Pass 1: the endpoint and method can come after the fields.
    local a=("$@")
    set -- "${a[@]}"
    while [ $# -gt 0 ]; do
        split_opt "$1" "${2-}"
        case "$OPT" in
            -X) method="$VAL" ;;
            -f|-F|--input) fields=1 ;;
            "") [[ "$1" == -* ]] || endpoint="${endpoint:-$1}" ;;
        esac
        shift
        [ "$NUSED" = 2 ] && [ $# -gt 0 ] && shift
    done
    endpoint=$(api_path "$endpoint")
    [ "$endpoint" = graphql ] && graphql_cmd "${a[@]}"
    [ -n "$method" ] || { [ "$fields" = 1 ] && method=POST || method=GET; }
    method="${method^^}"
    [[ "$endpoint" =~ ^repos/[^/]+/[^/]+/issues/([0-9]+/comments|comments/[0-9]+)$ ]] || passthrough
    [[ "$method" == POST || "$method" == PATCH ]] || passthrough

    # Pass 2: rewrite the body. JSON jq cannot parse goes on unchanged, from the
    # copy already read.
    set -- "${a[@]}"
    while [ $# -gt 0 ]; do
        split_opt "$1" "${2-}"
        if [[ "$OPT" == -f || "$OPT" == -F ]] && [[ "$VAL" == body=* ]]; then
            v="${VAL#body=}"
            if [ "$OPT" = -F ] && [[ "$v" == @* ]]; then v=$(read_src "${v#@}") || passthrough; fi
            args+=(-f "body=$(stamp "$v")")
        elif [ "$OPT" = --input ]; then
            json=$(read_src "$VAL") || passthrough
            if [ "$(jq -r '.body | type' <<<"$json" 2>/dev/null)" = string ]; then
                v=$(jq -r '.body' <<<"$json" 2>/dev/null) || v=""
                stamped=$(jq -c --arg b "$(stamp "$v")" '.body = $b' <<<"$json" 2>/dev/null) && json="$stamped"
            fi
            args+=(--input -); use_stdin=1
        else
            args+=("${@:1:NUSED}")
        fi
        shift
        [ "$NUSED" = 2 ] && [ $# -gt 0 ] && shift
    done
    [ "$use_stdin" = 1 ] && exec "$real" api "${args[@]}" < <(printf '%s' "$json")
    exec "$real" api "${args[@]}"
}

case "${1:-}" in
    issue|pr)
        action=$(dispatch_action "${@:2}")
        case "$1 $action" in
            "issue comment"|"pr comment") comment_cmd "$@" ;;
            "issue close"|"issue reopen"|"pr close"|"pr reopen") close_cmd "$@" ;;
        esac
        ;;
    api) api_cmd "$@" ;;
esac
passthrough
