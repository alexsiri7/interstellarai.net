#!/usr/bin/env bash
# `gh` for the factory user: every issue or PR conversation comment an archon
# session posts ends with <!-- lachesis:automated -->, then the real gh runs.
# Factory runs post as the owner, so without the line Lachesis takes an agent's
# own comment on a question-blocked issue for the author's answer (lachesis
# #386, interstellarai.net#298). ops/cron's scripts stamp their own bodies; this
# covers the comments agents compose themselves.
#
# Installed root-owned at /usr/local/lib/archon-user/gh-shim/gh by install.sh;
# that directory holds only this file and is first on the PATH archon_env (in
# archon-as-archon) and archon-serve.service give every factory session.
#
# Stamped: `issue|pr comment` (the body moves to --body-file -), the -c/--comment
# of `issue|pr close|reopen`, and `api` POST/PATCH to repos/{o}/{r}/issues/{n}/comments
# or repos/{o}/{r}/issues/comments/{id} (-f/-F body=, or --input JSON's .body).
# A GraphQL addComment/updateIssueComment is refused (exit 2) rather than
# rewritten. Everything else, and any body source that cannot be read, goes to
# the real gh unchanged.
#
# set -u, not -e: the wrapper must never fail where the real gh would succeed.
set -u
MARKER='<!-- lachesis:automated -->'

real=""
IFS=: read -r -a _dirs <<<"${PATH:-}"
for d in "${_dirs[@]}"; do
    [ -n "$d" ] || continue
    c="$d/gh"
    if [ -f "$c" ] && [ -x "$c" ] && ! [ "$c" -ef "${BASH_SOURCE[0]}" ]; then real="$c"; break; fi
done
[ -n "$real" ] || { echo "gh (factory wrapper): no gh executable found on PATH" >&2; exit 127; }
orig=("$@")

# Strip trailing whitespace, append the marker unless it already ends the text.
# An empty body stays empty so the real gh still refuses it.
stamp() {
    local t="$1"
    while [[ "$t" == *[[:space:]] ]]; do t="${t%[[:space:]]}"; done
    if [ -z "$t" ] || [[ "$t" == *"$MARKER" ]]; then printf '%s' "$t"; else printf '%s\n\n%s' "$t" "$MARKER"; fi
}
read_src() { if [ "$1" = - ]; then cat; else cat -- "$1"; fi; }
passthrough() { exec "$real" "${orig[@]}"; }

comment_cmd() {
    local out=("$1" "$2") body="" found=0 b
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--body) [ $# -ge 2 ] || passthrough; body="$2"; found=1; shift 2 ;;
            --body=*) body="${1#--body=}"; found=1; shift ;;
            -b?*) body="${1#-b}"; found=1; shift ;;
            -F|--body-file) [ $# -ge 2 ] || passthrough; b=$(read_src "$2") || passthrough; body="$b"; found=1; shift 2 ;;
            --body-file=*) b=$(read_src "${1#--body-file=}") || passthrough; body="$b"; found=1; shift ;;
            -F?*) b=$(read_src "${1#-F}") || passthrough; body="$b"; found=1; shift ;;
            --) out+=("$@"); break ;;
            *) out+=("$1"); shift ;;
        esac
    done
    [ "$found" = 1 ] || passthrough
    exec "$real" "${out[@]}" --body-file - < <(stamp "$body")
}

close_cmd() {
    local out=("$1" "$2")
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--comment) [ $# -ge 2 ] || break; out+=("$1" "$(stamp "$2")"); shift 2 ;;
            --comment=*) out+=("--comment=$(stamp "${1#--comment=}")"); shift ;;
            -c?*) out+=(-c "$(stamp "${1#-c}")"); shift ;;
            --) break ;;
            *) out+=("$1"); shift ;;
        esac
    done
    exec "$real" "${out[@]}" "$@"
}

# split_opt <arg> [<next>]: when <arg> is one of gh api's value-taking flags,
# OPT is its canonical name (-X, -f, -F, --input, ...) and VAL its value, and
# NUSED is how many words it took (1 for --flag=v and -fv, 2 for --flag v).
split_opt() {
    OPT="" VAL="" NUSED=1
    case "$1" in
        -X|--method|-f|--raw-field|-F|--field|-H|--header|-q|--jq|-t|--template|--hostname|--cache|-p|--preview|--input)
            OPT="$1" VAL="${2-}" NUSED=2 ;;
        --method=*|--raw-field=*|--field=*|--header=*|--jq=*|--template=*|--hostname=*|--cache=*|--preview=*|--input=*)
            OPT="${1%%=*}" VAL="${1#*=}" ;;
        -[XfFHqtp]?*) OPT="${1:0:2}" VAL="${1:2}" ;;
    esac
    case "$OPT" in --method) OPT=-X ;; --raw-field) OPT=-f ;; --field) OPT=-F ;; esac
}

api_cmd() {
    local endpoint="" method="" fields=0 query="" q args=() json="" use_stdin=0 v
    shift
    # Pass 1: the endpoint and method can come after the fields.
    local a=("$@")
    set -- "${a[@]}"
    while [ $# -gt 0 ]; do
        split_opt "$1" "${2-}"
        case "$OPT" in
            -X) method="$VAL" ;;
            -f|-F|--input)
                fields=1
                if [[ "$OPT" != --input && "$VAL" == query=* ]]; then
                    q="${VAL#query=}"
                    if [ "$OPT" = -F ] && [[ "$q" == @* && "$q" != @- ]]; then q=$(cat -- "${q#@}" 2>/dev/null); fi
                    query="$query$q"
                fi ;;
            "") [[ "$1" == -* ]] || endpoint="${endpoint:-$1}" ;;
        esac
        shift
        [ "$NUSED" = 2 ] && [ $# -gt 0 ] && shift
    done
    if [ "$endpoint" = graphql ] && [[ "$query" =~ addComment|updateIssueComment ]]; then
        echo "gh (factory wrapper): post issue and PR comments with 'gh issue comment' / 'gh pr comment' so they carry $MARKER (interstellarai.net#298)" >&2
        exit 2
    fi
    [ -n "$method" ] || { [ "$fields" = 1 ] && method=POST || method=GET; }
    method="${method^^}"
    [[ "$endpoint" =~ ^/?repos/[^/]+/[^/]+/issues/([0-9]+/comments|comments/[0-9]+)/?$ ]] || passthrough
    [[ "$method" == POST || "$method" == PATCH ]] || passthrough

    # Pass 2: rewrite the body.
    set -- "${a[@]}"
    while [ $# -gt 0 ]; do
        split_opt "$1" "${2-}"
        if [[ "$OPT" == -f || "$OPT" == -F ]] && [[ "$VAL" == body=* ]]; then
            v="${VAL#body=}"
            if [ "$OPT" = -F ] && [[ "$v" == @* ]]; then v=$(read_src "${v#@}") || passthrough; fi
            args+=(-f "body=$(stamp "$v")")
        elif [ "$OPT" = --input ]; then
            json=$(read_src "$VAL") || passthrough
            json=$(jq -c --arg m "$MARKER" 'if (.body|type)=="string" then .body |= (sub("\\s+$";"") | if . == "" or endswith($m) then . else . + "\n\n" + $m end) else . end' <<<"$json" 2>/dev/null) || passthrough
            args+=(--input -); use_stdin=1
        else
            args+=("${@:1:NUSED}")
        fi
        shift
        [ "$NUSED" = 2 ] && [ $# -gt 0 ] && shift
    done
    [ "$use_stdin" = 1 ] && exec "$real" api "${args[@]}" < <(printf '%s' "$json")
    exec "$real" api "${args[@]}"
}

case "${1:-} ${2:-}" in
    "issue comment"|"pr comment") comment_cmd "$@" ;;
    "issue close"|"issue reopen"|"pr close"|"pr reopen") close_cmd "$@" ;;
    "api "*) api_cmd "$@" ;;
esac
passthrough
