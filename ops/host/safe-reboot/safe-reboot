#!/usr/bin/env bash
# safe-reboot — installed to /usr/local/sbin by ops/host/install.sh (step 8).
#
#   safe-reboot status              # any user: what the gate would do now, and why (alias: --dry-run)
#   safe-reboot gate                # root, from safe-reboot.timer every 15 min
#   safe-reboot restore [--dry-run] # root, from safe-reboot-restore.service once per boot
#
# Replaces unattended-upgrades' Automatic-Reboot (which rebooted at 05:45 on
# whatever day /var/run/reboot-required appeared, 2026-09-26: mid-session).
#
# gate: acts only while /var/run/reboot-required exists and only inside the
# nightly window (SAFE_REBOOT_WINDOW, 02:30-06:30 local). It reboots when
# nothing is busy:
#   hard (never overridden)  the hold file; a DB backup / restore test / weekly
#                            maintenance / archon update script mid-run (a
#                            shell process -- bash/sh/dash, optional path and
#                            -flags -- whose script argument is the job script;
#                            a process that merely mentions the path, e.g. an
#                            editor, `tail`, `grep` or a claude prompt, does
#                            not count); apt, dpkg or unattended-upgrade running
#   soft (overridden by the  archon runs running (in the DB of the user the
#         deadline)          run-as flag names; paused runs are durable and
#                            resumable after boot, so they do not block --
#                            `status` lists them as info); an `archon workflow
#                            run` process; a Claude transcript (.jsonl under any
#                            user's ~/.claude/projects) written in the last
#                            SAFE_REBOOT_ACTIVE_MIN (30) minutes; a maintenance
#                            job or apt/dpkg process running for longer than
#                            SAFE_REBOOT_JOB_MAX_H (12) hours (`ps -o etimes=`):
#                            these take minutes to an hour, so it looks stuck
# Lameduck: while a reboot is pending, from SAFE_REBOOT_PREDRAIN_MIN (60)
# minutes before the window opens until it closes (deadline or not: the forced
# reboot only happens in the window anyway), the gate sets the run-as flag to
# drain, so the factory launches nothing new and its running work finishes
# before the window
# (until 2026-11 the flag was drained only at the moment of rebooting, and the
# factory kept the host busy every night until the 72h deadline). The previous
# value is kept in $STATE/lameduck and put back when the window closes without a
# reboot (only if the flag is still our drain), when the reboot stops being
# pending or the hold file appears, or by the restore after the reboot. A drain
# someone else set is never touched; a flag changed by hand during the lameduck
# is left alone until the next night. One low-priority ntfy per pending reboot.
# SAFE_REBOOT_LAMEDUCK=0 turns it off (drain only at the moment of rebooting).
# Before rebooting it saves the run-as flag and sets it to drain (never
# overwriting a drain someone else set), re-checks archon, records the owner's
# running user services and interactive Claude sessions (cwd, session id, tmux
# session/window, permission flags), ntfys, syncs, reboots. A reboot pending
# longer than SAFE_REBOOT_DEADLINE_H (72) hours ignores the soft blockers: one
# urgent warning ntfy, then the reboot on the next tick at least 10 minutes
# later (touch the hold file in between to veto). While a reboot is pending and
# has not happened, one ntfy a day (from 07:00) says since when and why.
#
# SAFE_REBOOT_MODE=warm|cold (default warm). cold: after the sync, arm the RTC
# wake alarm for now + SAFE_REBOOT_WAKE_S (120) seconds through
# SAFE_REBOOT_RTC_WAKEALARM (/sys/class/rtc/rtc0/wakealarm), read it back, and
# power off (SAFE_REBOOT_POWEROFF_CMD, systemctl poweroff) instead of a warm
# reboot: this board (MSI Z370-A PRO, BIOS 2.D0) hangs in firmware/POST on
# unattended warm reboots after 5+ days up (Sep 25, Oct 5, Oct 15, Nov 1; the
# iTCO watchdog did not recover it), and only a power cycle clears that. If the
# alarm cannot be armed or does not read back, it logs that and reboots warm.
# Set it in /etc/default/safe-reboot (SAFE_REBOOT_CONF; root-owned, read by the
# units as an EnvironmentFile and grepped -- never sourced -- by `status`), and
# only after an attended test showed the host powers back on by itself.
#
# restore: puts the flag back, makes sure the right archon-serve unit (system
# unit under ARCHON_RUN_AS=archon, the owner's user unit otherwise) answers,
# restarts the recorded user services, recreates the tmux sessions with
# `claude --resume <id>` in the recorded cwd (idle, at the prompt), and ntfys a
# health summary.
#
# Root never executes or sources a file a user can edit: the ntfy topic is
# grepped out of secrets.env (as smartd-ntfy does), the run-as flag is parsed
# with sed, every archon CLI call and every write into the owner's home runs as
# that user through runuser.
#
# Every path and command is overridable through SAFE_REBOOT_* variables so
# ops/cron/tests/safe-reboot.bats can run it as a normal user against stubs.
set -uo pipefail

OWNER="${SAFE_REBOOT_OWNER:-asiri}"
OWNER_HOME="${SAFE_REBOOT_OWNER_HOME:-$(getent passwd "$OWNER" | cut -d: -f6)}"; OWNER_HOME="${OWNER_HOME:-/home/$OWNER}"
FACTORY_USER="${SAFE_REBOOT_FACTORY_USER:-archon}"
REBOOT_REQUIRED="${SAFE_REBOOT_REQUIRED:-/var/run/reboot-required}"
STATE="${SAFE_REBOOT_STATE_DIR:-/var/lib/safe-reboot}"
HOLD="${SAFE_REBOOT_HOLD:-$OWNER_HOME/.config/safe-reboot/hold}"
WINDOW="${SAFE_REBOOT_WINDOW:-02:30-06:30}"
DEADLINE_H="${SAFE_REBOOT_DEADLINE_H:-72}"
ACTIVE_MIN="${SAFE_REBOOT_ACTIVE_MIN:-30}"
DAILY_HOUR="${SAFE_REBOOT_DAILY_HOUR:-7}"
FORCE_GRACE_S="${SAFE_REBOOT_FORCE_GRACE_S:-600}"
FLAG_FILE="${SAFE_REBOOT_FLAG_FILE:-$OWNER_HOME/.config/archon-cron/run-as}"
SECRETS="${SAFE_REBOOT_SECRETS:-$OWNER_HOME/.config/archon-cron/secrets.env}"
ENGINE="${SAFE_REBOOT_ENGINE:-/mnt/ext-fast/archon}"
REPO="${SAFE_REBOOT_REPO:-/mnt/ext-fast/interstellarai.net}"
BUN="${SAFE_REBOOT_BUN:-$OWNER_HOME/.bun/bin/bun}"
WRAPPER="${SAFE_REBOOT_WRAPPER:-/usr/local/bin/archon-as-archon}"
SERVE_UNIT="${SAFE_REBOOT_SERVE_UNIT:-archon-serve.service}"
SERVE_URL="${SAFE_REBOOT_SERVE_URL:-http://127.0.0.1:3090/}"
BOOT_ID_FILE="${SAFE_REBOOT_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
REBOOT_CMD="${SAFE_REBOOT_REBOOT_CMD:-systemctl reboot}"
SYNC_TIMEOUT="${SAFE_REBOOT_SYNC_TIMEOUT:-900}"
WAIT_S="${SAFE_REBOOT_WAIT_S:-120}"
# Homes whose ~/.claude/projects count as "a Claude session is working".
# Default: every passwd entry with a ~/.claude/projects directory.
HOMES="${SAFE_REBOOT_HOMES:-}"
# Scripts that must not be cut off (ops/cron/crontab): the 3-hourly DB backup,
# the Sunday restore test, weekly apt maintenance, the weekly archon update and
# the Sunday cache trim. Plus apt/dpkg themselves. pgrep -f matches the whole
# command line, so the pattern is anchored: a shell (optional path, optional
# -flags, e.g. cron's `/bin/sh -c`) whose first operand is the job script.
JOB_SH_RE='^(/usr)?(/bin/)?(ba|da)?sh( -[A-Za-z]+)* [^ ]*'
JOBS_RE="${SAFE_REBOOT_JOBS_RE:-${JOB_SH_RE}ops/cron/(backup-dbs|restore-test|system-maintenance|archon-update)\.sh( |\$)|${JOB_SH_RE}ops/cron/pipeline-health-cron\.sh --trim( |\$)}"
APT_RE="${SAFE_REBOOT_APT_RE:-^(/usr/bin/)?(dpkg|apt|apt-get|aptitude)( |$)|/usr/bin/unattended-upgrade( |$)|apt\.systemd\.daily}"
RUNS_PROC_RE='archon workflow run |cli\.ts workflow run '
# A maintenance job / apt process older than this is stuck: soft, not hard.
JOB_MAX_H="${SAFE_REBOOT_JOB_MAX_H:-12}"

# Lameduck (pre-drain): 1 = on; minutes before the window opens it starts.
LAMEDUCK="${SAFE_REBOOT_LAMEDUCK:-1}"
PREDRAIN_MIN="${SAFE_REBOOT_PREDRAIN_MIN:-60}"
LD_FILE="$STATE/lameduck"
# Reboot mode. The units read $CONF as an EnvironmentFile; for a run by hand
# (`status`) the two mode settings are grepped out of it, never sourced.
CONF="${SAFE_REBOOT_CONF:-/etc/default/safe-reboot}"
conf_get() {
    [ -r "$CONF" ] || return 0
    sed -nE "s/^[[:space:]]*$1=[\"']?([A-Za-z0-9_.-]*)[\"']?[[:space:]]*(#.*)?\$/\\1/p" "$CONF" | tail -n 1
}
MODE="${SAFE_REBOOT_MODE:-$(conf_get SAFE_REBOOT_MODE)}"; MODE="${MODE:-warm}"
WAKE_S="${SAFE_REBOOT_WAKE_S:-$(conf_get SAFE_REBOOT_WAKE_S)}"; WAKE_S="${WAKE_S:-120}"
[[ "$WAKE_S" =~ ^[0-9]+$ ]] && [ "$WAKE_S" -ge 30 ] || WAKE_S=120
RTC_WAKEALARM="${SAFE_REBOOT_RTC_WAKEALARM:-/sys/class/rtc/rtc0/wakealarm}"
POWEROFF_CMD="${SAFE_REBOOT_POWEROFF_CMD:-systemctl poweroff}"

TOOL="${SAFE_REBOOT_TOOL:-safe-reboot}"
NOW="${SAFE_REBOOT_NOW:-$(date +%s)}"
ME=$(id -un)
IS_ROOT=0; [ "$(id -u)" -eq 0 ] && IS_ROOT=1

log()  { printf '%s [%s] %s\n' "$(date -d "@$NOW" '+%F %T')" "$TOOL" "$*"; }
line() { printf '    %s\n' "$*"; }

boot_id() { cat "$BOOT_ID_FILE" 2>/dev/null || echo unknown; }
fmt_ts()  { date -d "@$1" '+%a %d %b %H:%M'; }
hm_to_min() { local h=${1%%:*} m=${1##*:}; echo $(( 10#$h * 60 + 10#$m )); }

# ------------------------------------------------------------ as a user -----
# as_user <user> <cmd...> — run as <user>: directly when we are that user,
# through runuser when root, otherwise fail with 126 ("needs root").
as_user() {
    local u="$1"; shift
    if [ "$ME" = "$u" ]; then "$@"
    elif [ "$IS_ROOT" -eq 1 ]; then runuser -u "$u" -- "$@"
    else return 126; fi
}
# owner_systemctl <args...> — the owner's user manager.
owner_systemctl() {
    if [ "$ME" = "$OWNER" ]; then systemctl --user "$@"
    elif [ "$IS_ROOT" -eq 1 ]; then systemctl --user -M "$OWNER@" "$@"
    else return 126; fi
}
owner_tmux() {
    as_user "$OWNER" env HOME="$OWNER_HOME" XDG_RUNTIME_DIR="/run/user/$(id -u "$OWNER" 2>/dev/null || echo 1000)" tmux "$@"
}

# ----------------------------------------------------------------- ntfy -----
# The topic is grepped, never sourced: root must not execute a file the owner
# can edit (same rule as ops/host/smartd-ntfy).
DRY=0
notify() {  # title body [priority] [tags]
    local title="$1" body="$2" prio="${3:-default}" tags="${4:-arrows_counterclockwise}" topic=""
    if [ "$DRY" -eq 1 ]; then line "would ntfy ($prio): $title — $body"; return 0; fi
    [ -r "$SECRETS" ] && topic=$(grep -E '^NTFY_TOPIC=' "$SECRETS" | head -n1 | cut -d= -f2- | tr -d '"'"'")
    if [ -z "$topic" ]; then log "WARNING: NTFY_TOPIC not found in $SECRETS — not delivered: $title"; return 0; fi
    curl -s --fail -o /dev/null --max-time 20 -H "Title: $title" -H "Priority: $prio" -H "Tags: $tags" \
        -d "$body" "https://ntfy.sh/$topic" || log "WARNING: ntfy failed: $title"
    return 0
}

# ------------------------------------------------------------- run-as flag --
# Same parse as ops/cron/lib/run-as.sh; "unknown" when it cannot be read.
flag_read() {
    if [ ! -e "$FLAG_FILE" ]; then echo asiri; return; fi
    [ -r "$FLAG_FILE" ] || { echo unknown; return; }
    local m
    m=$(sed -nE 's/^[[:space:]]*ARCHON_RUN_AS=["'\'']?([a-z]+)["'\'']?[[:space:]]*(#.*)?$/\1/p' "$FLAG_FILE" | tail -n 1)
    case "$m" in archon|drain) echo "$m" ;; *) echo asiri ;; esac
}
FLAG_MARK="safe-reboot"
# flag_write <value> <header> — same shape as ops/host/archon-user/install.sh
# set_flag (one comment line, ARCHON_RUN_AS=<value>, 0600, owner's), written
# as the owner with mktemp + mv in the same directory.
flag_write() {
    local val="$1" header="$2"
    # shellcheck disable=SC2016  # expanded by the inner sh
    as_user "$OWNER" sh -c 'set -e; d=$(dirname "$1"); mkdir -p "$d"; t=$(mktemp "$1.XXXXXX");
        printf "%s\nARCHON_RUN_AS=%s\n" "$3" "$2" > "$t"; chmod 0600 "$t"; mv -f "$t" "$1"' \
        sh "$FLAG_FILE" "$val" "$header"
}
flag_ours() { grep -q "$FLAG_MARK" "$FLAG_FILE" 2>/dev/null; }

# ------------------------------------------------------------ busy checks ---
# Each check appends "hard:<reason>" or "soft:<reason>" lines to $REASONS.
REASONS=""
add() { REASONS+="$1"$'\n'; }

check_hold() {
    [ -e "$HOLD" ] || return 0
    local why; why=$(head -c 200 "$HOLD" 2>/dev/null | head -n 1)
    add "hard:hold file $HOLD (since $(fmt_ts "$(stat -c %Y "$HOLD")"))${why:+: $why}"
}

# Splits `pgrep -a` lines into hard (younger than JOB_MAX_H) and soft (older:
# stuck) reasons. A process whose age cannot be read (gone already) is hard.
add_procs() {
    local what=$1 lines=$2 pid age hard="" stuck="" max=$(( JOB_MAX_H * 3600 ))
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        pid=${line%% *}
        age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
        if [[ "$age" =~ ^[0-9]+$ ]] && [ "$age" -gt "$max" ]; then
            stuck+="$line (running $(( age / 3600 ))h);"
        else
            hard+="$line;"
        fi
    done < <(head -n 3 <<<"$lines")
    [ -n "$hard" ] && add "hard:$what running: $(cut -c1-200 <<<"$hard")"
    [ -n "$stuck" ] && add "soft:$what running for over ${JOB_MAX_H}h, looks stuck: $(cut -c1-200 <<<"$stuck")"
    return 0
}

check_jobs() {
    local out
    out=$(pgrep -af -- "$JOBS_RE" 2>/dev/null | grep -v -- "$TOOL")
    add_procs "maintenance job" "$out"
    out=$(pgrep -af -- "$APT_RE" 2>/dev/null)
    add_procs "apt/dpkg" "$out"
    return 0
}

# runs_count <status> — count of archon runs in the DB of the user the flag
# names; "unknown" when the query fails (which counts as busy).
runs_count() {
    local st="$1" flag="$2" raw
    if [ "$flag" = archon ]; then
        # The shape ops/host/archon-user/install.sh --rollback uses; the wrapper
        # validates argv. As root through runuser; as the owner through the
        # one sudo rule the cron path (lib/archon-shim) uses.
        if [ "$IS_ROOT" -eq 1 ] || [ "$ME" = "$FACTORY_USER" ]; then
            raw=$(cd / && as_user "$FACTORY_USER" "$WRAPPER" workflow runs --all --status "$st" --json 2>/dev/null) || { echo unknown; return; }
        else
            raw=$(cd / && sudo -n -u "$FACTORY_USER" "$WRAPPER" workflow runs --all --status "$st" --json 2>/dev/null) || { echo unknown; return; }
        fi
    else
        # The shape install.sh --cutover's drain check uses, as the owner, clean env.
        raw=$(cd / && as_user "$OWNER" env -i HOME="$OWNER_HOME" PATH="$OWNER_HOME/.bun/bin:/usr/bin:/bin" CLAUDECODE=0 \
              ARCHON_SUPPRESS_NESTED_CLAUDE_WARNING=1 "$BUN" "$ENGINE/packages/cli/src/cli.ts" \
              workflow runs --all --status "$st" --limit 100 --json --cwd "$REPO" 2>/dev/null) || { echo unknown; return; }
    fi
    printf '%s' "$raw" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["runs"]))' 2>/dev/null || echo unknown
}

check_archon() {
    local flag="$1" who st n p
    case "$flag" in archon) who="$FACTORY_USER" ;; unknown) add "soft:run-as flag $FLAG_FILE unreadable"; return 0 ;; *) who="$OWNER" ;; esac
    # Only running runs: a paused run is durable in the DB and resumable after
    # boot, and it never finishes by itself (it blocked every tick of Oct 28-31).
    n=$(runs_count running "$flag")
    if [ "$n" = unknown ]; then add "soft:archon running runs in $who's DB: unknown (query failed)"
    elif [ "$n" != 0 ]; then add "soft:archon: $n running run(s) in $who's DB"; fi
    p=$(pgrep -fc -- "$RUNS_PROC_RE" 2>/dev/null || true)
    [ "${p:-0}" -gt 0 ] && add "soft:$p 'archon workflow run' process(es)"
    return 0
}

list_homes() {
    if [ -n "$HOMES" ]; then tr ' ' '\n' <<<"$HOMES"; return; fi
    getent passwd | cut -d: -f6 | sort -u | while read -r h; do [ -d "$h/.claude/projects" ] && echo "$h"; done
}

check_claude() {
    local h f unread=()
    while read -r h; do
        [ -n "$h" ] || continue
        if [ ! -r "$h/.claude/projects" ] || [ ! -x "$h/.claude/projects" ]; then unread+=("$h"); continue; fi
        f=$(find "$h/.claude/projects" -name '*.jsonl' -mmin "-$ACTIVE_MIN" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1)
        [ -n "$f" ] && add "soft:Claude session active in the last ${ACTIVE_MIN}m: ${f#* } ($(date -d "@${f%%.*}" +%H:%M))"
    done < <(list_homes)
    [ "${#unread[@]}" -gt 0 ] && UNREAD_NOTE="cannot read ${unread[*]} ~/.claude/projects (needs root) — not counted"
    return 0
}

evaluate() {  # fills REASONS
    REASONS=""; UNREAD_NOTE=""
    check_hold
    check_jobs
    check_archon "$(archon_flag)"
    check_claude
}
reasons_of() { grep "^$1:" <<<"$REASONS" | cut -d: -f2-; }
reasons_csv() { grep -v '^$' <<<"$REASONS" | cut -d: -f2- | paste -sd';' | sed 's/;/; /g'; }

in_window() {
    local s e n
    s=$(hm_to_min "${WINDOW%-*}"); e=$(hm_to_min "${WINDOW#*-}"); n=$(hm_to_min "$(date -d "@$NOW" +%H:%M)")
    if [ "$s" -le "$e" ]; then [ "$n" -ge "$s" ] && [ "$n" -lt "$e" ]
    else [ "$n" -ge "$s" ] || [ "$n" -lt "$e" ]; fi
}

# ------------------------------------------------------------- lameduck ----
# $LD_FILE (boot_id, at, flag_prev) exists while the gate holds the factory
# drained ahead of / during the window. The drain is ours only while the flag
# still says drain with our mark in it.
ld_get() { sed -n "s/^$1=//p" "$LD_FILE" 2>/dev/null; }
lameduck_on() { [ -r "$LD_FILE" ] && [ "$(ld_get boot_id)" = "$(boot_id)" ] && [ "$(flag_read)" = drain ] && flag_ours; }
# archon_flag — whose run DB to ask: under our lameduck drain, the user the
# flag named before it (archon after the cutover), else the flag itself.
archon_flag() { if lameduck_on; then ld_get flag_prev; else flag_read; fi; }

# predrain_now — within PREDRAIN_MIN minutes before the window opens.
predrain_now() {
    local s n d
    s=$(hm_to_min "${WINDOW%-*}"); n=$(hm_to_min "$(date -d "@$NOW" +%H:%M)")
    d=$(( (s - n + 1440) % 1440 ))
    [ "$d" -gt 0 ] && [ "$d" -le "$PREDRAIN_MIN" ]
}
lameduck_start_hm() { local s=$(( ($(hm_to_min "${WINDOW%-*}") - PREDRAIN_MIN + 1440) % 1440 )); printf '%02d:%02d' $(( s / 60 )) $(( s % 60 )); }

# lameduck_end <reason> — put the flag back (only if it is still our drain).
lameduck_end() {
    [ -e "$LD_FILE" ] || return 0
    local prev; prev=$(ld_get flag_prev)
    if [ "$DRY" -eq 1 ]; then line "lameduck: would end ($1) and put ARCHON_RUN_AS=$prev back"; return 0; fi
    if [ "$(flag_read)" = drain ] && flag_ours; then
        if flag_write "$prev" "# Written by $FLAG_MARK (lameduck ended: $1) — read by ops/cron/lib/run-as.sh"; then
            log "lameduck ended ($1): flag back to ARCHON_RUN_AS=$prev"
        else log "WARNING: lameduck ended ($1) but the flag could not be put back to $prev"; return 1; fi
    else
        log "lameduck ended ($1): flag changed since ($(flag_read)) — left alone"
    fi
    rm -f "$LD_FILE"
}

# lameduck_tick <since> — start, keep or end the pre-drain. Only from
# PREDRAIN_MIN before the window to its end, past the deadline too: the forced
# reboot happens only in the window, so draining earlier only idles the factory.
lameduck_tick() {
    local since=$1 flag why=""
    if [ -e "$LD_FILE" ] && [ "$(ld_get boot_id)" != "$(boot_id)" ]; then
        lameduck_end "left over from an earlier boot"
    fi
    if [ "$LAMEDUCK" != 1 ]; then why="off (SAFE_REBOOT_LAMEDUCK=$LAMEDUCK)"
    elif [ -e "$HOLD" ]; then why="hold file"
    elif ! in_window && ! predrain_now; then why="window closed"; fi
    if [ -n "$why" ]; then
        if [ -e "$LD_FILE" ]; then lameduck_end "$why"
        elif [ "$LAMEDUCK" = 1 ] && [ "$why" = "window closed" ]; then line "lameduck: starts at $(lameduck_start_hm) (${PREDRAIN_MIN}m before the window $WINDOW)"
        else line "lameduck: $why"; fi
        return 0
    fi
    # Due now.
    flag=$(flag_read)
    if [ -e "$LD_FILE" ]; then
        if lameduck_on; then line "lameduck: active since $(fmt_ts "$(ld_get at)") — ARCHON_RUN_AS=drain (was $(ld_get flag_prev); put back when the window closes or after the reboot)"
        else line "lameduck: flag changed by hand since $(fmt_ts "$(ld_get at)") (now $flag) — not draining again until the next window"; fi
        return 0
    fi
    case "$flag" in
        unknown) line "lameduck: cannot read $FLAG_FILE — not draining"; return 0 ;;
        drain)   line "lameduck: flag already drain (not set by the lameduck) — left alone"; return 0 ;;
    esac
    local when="window $WINDOW"
    if [ "$DRY" -eq 1 ]; then line "lameduck: would set ARCHON_RUN_AS=drain now (was $flag; $when)"; return 0; fi
    # The state file before the flag: whatever happens next, the old value is on disk.
    printf 'boot_id=%s\nat=%s\nflag_prev=%s\n' "$(boot_id)" "$NOW" "$flag" > "$LD_FILE"
    if ! flag_write drain "# Written by $FLAG_MARK lameduck: reboot pending (was ARCHON_RUN_AS=$flag; put back when the window closes or after the reboot) — read by ops/cron/lib/run-as.sh"; then
        log "WARNING: lameduck: could not set the flag to drain"; rm -f "$LD_FILE"; return 0
    fi
    log "lameduck: flag ARCHON_RUN_AS=drain (was $flag; $when) — no new archon work until the reboot"
    if [ "$(cat "$STATE/lameduck-notified" 2>/dev/null)" != "$since" ]; then
        notify "Draining the factory on $(hostname) for a reboot" \
            "Reboot pending since $(fmt_ts "$since"); ARCHON_RUN_AS=drain (was $flag) so running work finishes before the window $WINDOW. Put back when the window closes without a reboot, or after it. Veto: touch $HOLD" low arrows_counterclockwise
        echo "$since" > "$STATE/lameduck-notified"
    fi
}

# pending_since — epoch this boot first saw reboot-required. Persisted in
# $STATE (reboot-required lives on tmpfs and apt touches it again on every
# upgrade that needs a reboot, so its mtime is not "since").
pending_since() {
    local f="$STATE/pending-since" b since sb
    b=$(boot_id)
    if [ -r "$f" ]; then read -r since sb < "$f"; [ "$sb" = "$b" ] && [ -n "$since" ] && { echo "$since"; return; }; fi
    since=$(stat -c %Y "$REBOOT_REQUIRED" 2>/dev/null || echo "$NOW")
    [ "$since" -gt "$NOW" ] && since=$NOW
    if [ "$DRY" -eq 0 ]; then printf '%s %s\n' "$since" "$b" > "$f"; fi
    echo "$since"
}

# ------------------------------------------------------- record for restore -
# services.tsv: unit <TAB> how (start|runtime) <TAB> target unit
# A transient unit (systemd-run) is gone after a reboot: it is restarted as the
# persistent unit in ~/.config/systemd/user with the same ExecStart when one
# exists (cloud-mirror-firstrun -> cloud-mirror.service), else its unit file
# is saved and re-installed as a runtime unit (/run/user/<uid>/systemd/user).
record_services() {
    local out="$1" u frag ufs exe tgt p
    : > "$out"
    owner_systemctl list-units --type=service --state=running,activating --no-legend --plain 2>/dev/null \
      | awk '{print $1}' | while read -r u; do
        [ -n "$u" ] && [ "$u" != "$SERVE_UNIT" ] || continue
        frag=$(owner_systemctl show "$u" -p FragmentPath --value 2>/dev/null)
        ufs=$(owner_systemctl show "$u" -p UnitFileState --value 2>/dev/null)
        [ "$ufs" = enabled ] && continue                       # comes back by itself
        case "$frag" in "$OWNER_HOME"/.config/systemd/user/*|/run/user/*/systemd/transient/*) ;; *) continue ;; esac
        if [ "$ufs" != transient ]; then printf '%s\tstart\t%s\n' "$u" "$u" >> "$out"; continue; fi
        exe=$(owner_systemctl show "$u" -p ExecStart --value 2>/dev/null | sed -nE 's/.*argv\[\]=([^;]*);.*/\1/p' | sed 's/ *$//')
        tgt=""
        for p in "$OWNER_HOME"/.config/systemd/user/*.service; do
            [ -e "$p" ] || continue
            [ "$(owner_systemctl show "${p##*/}" -p ExecStart --value 2>/dev/null | sed -nE 's/.*argv\[\]=([^;]*);.*/\1/p' | sed 's/ *$//')" = "$exe" ] \
                && { tgt="${p##*/}"; break; }
        done
        if [ -n "$tgt" ]; then printf '%s\tstart\t%s\n' "$u" "$tgt" >> "$out"
        else cp "$frag" "$STATE/restore/unit.$u" 2>/dev/null && printf '%s\truntime\t%s\n' "$u" "$u" >> "$out"; fi
    done
}

# sessions.tsv: user <TAB> session_id <TAB> cwd <TAB> tmux session <TAB> window index <TAB> window name <TAB> flags
# From ~/.claude/sessions/<pid>.json (written by every claude process): only
# live (pid + start time match) interactive CLI sessions; the factory's
# sdk-ts sessions are archon's to resume, not ours.
record_sessions() {
    local out="$1" h u panes
    : > "$out"
    while read -r h; do
        [ -d "$h/.claude/sessions" ] && [ -r "$h/.claude/sessions" ] || continue
        u=$(stat -c %U "$h")
        panes=$(owner_tmux list-panes -a -F '#{pane_id}	#{session_name}	#{window_index}	#{window_name}' 2>/dev/null || true)
        [ "$u" = "$OWNER" ] || panes=""
        PANES="$panes" SR_USER="$u" python3 - "$h/.claude/sessions" >> "$out" <<'PY'
import json, os, sys, glob
panes = {}
for l in os.environ.get("PANES", "").splitlines():
    f = l.split("\t")
    if len(f) == 4:
        panes[f[0]] = f[1:]
KEEP = ("--permission-mode", "--model", "--effort", "--agent")
KEEP_BARE = ("--dangerously-skip-permissions", "--allow-dangerously-skip-permissions")
for path in sorted(glob.glob(os.path.join(sys.argv[1], "*.json"))):
    try:
        d = json.load(open(path))
        pid = int(d["pid"])
        if d.get("kind") != "interactive" or d.get("entrypoint") != "cli":
            continue
        stat = open(f"/proc/{pid}/stat").read()
        start = stat.rsplit(")", 1)[1].split()[19]
        if str(d.get("procStart", start)) != start:
            continue
        argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        argv = [a.decode(errors="replace") for a in argv if a][1:]
    except (OSError, ValueError, KeyError, IndexError):
        continue
    flags, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in KEEP_BARE or any(a.startswith(k + "=") for k in KEEP):
            flags.append(a)
        elif a in KEEP and i + 1 < len(argv):
            flags.append(f"{a}={argv[i + 1]}"); i += 1
        i += 1
    pane = str(d.get("tmux") or "")
    if not pane:
        try:
            env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
            pane = next((e[10:].decode() for e in env if e.startswith(b"TMUX_PANE=")), "")
        except OSError:
            pane = ""
    pane_id = pane.rsplit(".", 1)[-1] if pane else ""
    sess, widx, wname = panes.get(pane_id, ["", "", ""])
    if not sess and pane and ":" in pane:
        sess = pane.split(":", 1)[0]
    # "-" for empty: bash `read` with IFS=tab collapses empty fields.
    row = [os.environ["SR_USER"], d["sessionId"], d.get("cwd", ""), sess or "restored", widx or "-", wname or "claude", " ".join(flags) or "-"]
    print("\t".join(str(x).replace("\t", " ").replace("\n", " ") for x in row))
PY
    done < <(list_homes)
}

# --------------------------------------------------------------- the gate ---
ABORT_FLAG_PREV=""
restore_flag_on_abort() {
    # Always drop the record: a reboot that did not go ahead is not pending.
    [ -n "$ABORT_FLAG_PREV" ] || { rm -rf "$STATE/restore"; return 0; }
    if flag_ours; then
        flag_write "$ABORT_FLAG_PREV" "# Written by safe-reboot (reboot aborted, flag put back) — read by ops/cron/lib/run-as.sh" \
            && log "flag put back to ARCHON_RUN_AS=$ABORT_FLAG_PREV (reboot aborted)"
    fi
    rm -rf "$STATE/restore"
    ABORT_FLAG_PREV=""
}

cmd_gate() {
    [ "$DRY" -eq 1 ] || [ "$IS_ROOT" -eq 1 ] || [ -n "${SAFE_REBOOT_TEST:-}" ] || { echo "gate needs root (or: $TOOL status)" >&2; exit 1; }
    [ "$DRY" -eq 1 ] || mkdir -p "$STATE"
    local b; b=$(boot_id)

    # A recorded reboot that never happened (reboot command failed, or the
    # host was powered off by hand before it) must not leave the factory drained.
    if [ "$DRY" -eq 0 ] && [ -r "$STATE/restore/meta" ] && grep -qx "boot_id=$b" "$STATE/restore/meta" \
       && [ $(( NOW - $(stat -c %Y "$STATE/restore/meta") )) -gt 1200 ]; then
        ABORT_FLAG_PREV=$(sed -n 's/^flag_prev=//p' "$STATE/restore/meta")
        [ "$(sed -n 's/^flag_written=//p' "$STATE/restore/meta")" = 1 ] || ABORT_FLAG_PREV=""
        if [ "$(sed -n 's/^lameduck=//p' "$STATE/restore/meta")" = 1 ]; then
            # The drain is the lameduck's: it ends when the window closes.
            ABORT_FLAG_PREV=""
            log "a reboot recorded 20+ minutes ago on this boot never happened — the lameduck drain stays until the window closes"
        else
            log "a reboot recorded 20+ minutes ago on this boot never happened — undoing the drain"
        fi
        restore_flag_on_abort; rm -rf "$STATE/restore"
        notify "Reboot did not happen on $(hostname)" "safe-reboot recorded a reboot on this boot that never took place; the archon flag was put back. Check: journalctl -u safe-reboot.service" high warning
    fi

    local since age overdue=0 pkgs
    # A restore that never ran (or died) after a safe-reboot leaves the flag on
    # our drain with nothing pending to notice it: put the flag back from the
    # meta of the previous boot. Only the flag — services and sessions may be
    # half-restored, and starting them twice is worse than not at all.
    if [ "$DRY" -eq 0 ] && [ -r "$STATE/restore/meta" ] && ! grep -qx "boot_id=$b" "$STATE/restore/meta"; then
        local p w
        p=$(sed -n 's/^flag_prev=//p' "$STATE/restore/meta"); w=$(sed -n 's/^flag_written=//p' "$STATE/restore/meta")
        log "state recorded before an earlier reboot was never restored — putting the flag back only"
        if [ "$w" = 1 ] && [ "$(flag_read)" = drain ] && flag_ours; then
            flag_write "$p" "# Written by $FLAG_MARK (restore had not run after the reboot) — read by ops/cron/lib/run-as.sh" \
                && log "flag back to ARCHON_RUN_AS=$p"
        fi
        rm -rf "$STATE/restored.last"; mv "$STATE/restore" "$STATE/restored.last"; rm -f "$LD_FILE"
        notify "safe-reboot restore did not run on $(hostname)" \
            "The state recorded before the last reboot was never restored (journalctl -u safe-reboot-restore.service -b -1). Flag: $(flag_read). Services and Claude sessions were NOT restarted: see $STATE/restored.last." high warning
    fi

    if [ ! -e "$REBOOT_REQUIRED" ]; then
        log "no reboot pending ($REBOOT_REQUIRED absent)"
        lameduck_end "no reboot pending"
        if [ "$DRY" -eq 0 ]; then rm -f "$STATE/pending-since" "$STATE/force-warned" "$STATE/last-blocked" "$STATE/lameduck-notified"; return 0; fi
        line "(status: evaluating as if one had just become pending)"
        since=$NOW
    else
        since=$(pending_since)
    fi
    age=$(( NOW - since ))
    [ "$age" -gt $(( DEADLINE_H * 3600 )) ] && overdue=1
    pkgs=$( [ -r "$REBOOT_REQUIRED.pkgs" ] && sort -u "$REBOOT_REQUIRED.pkgs" | paste -sd' ' )
    log "reboot pending since $(fmt_ts "$since") ($(( age / 3600 ))h; deadline ${DEADLINE_H}h; mode $(reboot_mode)${pkgs:+; $pkgs})"

    lameduck_tick "$since"
    evaluate
    local hard soft
    hard=$(reasons_of hard); soft=$(reasons_of soft)
    [ -n "$UNREAD_NOTE" ] && line "note: $UNREAD_NOTE"
    if [ -n "$REASONS" ]; then line "busy:"; grep -v '^$' <<<"$REASONS" | sed 's/^/      - /'; else line "idle: nothing blocks a reboot"; fi
    if [ "$DRY" -eq 1 ]; then
        local af np; af=$(archon_flag)
        if [ "$af" != unknown ]; then
            np=$(runs_count paused "$af")
            [ "$np" != 0 ] && line "info: archon paused run(s): $np — durable in the DB, resumable after boot; not a blocker"
        fi
    fi

    if ! in_window; then
        line "outside the window $WINDOW — no reboot now"
        daily_ntfy "$since" "$overdue"
        return 0
    fi
    if [ "$DRY" -eq 0 ]; then printf '%s\t%s\n' "$NOW" "$(reasons_csv)" > "$STATE/last-blocked"; fi

    if [ -n "$hard" ]; then
        line "decision: wait — hard blocker (the deadline never overrides these)"
        return 0
    fi
    local forced=0
    if [ -n "$soft" ]; then
        if [ "$overdue" -eq 0 ]; then line "decision: wait — busy, not overdue"; return 0; fi
        local warned=0
        [ -r "$STATE/force-warned" ] && warned=$(cat "$STATE/force-warned")
        if [ $(( NOW - warned )) -gt 3600 ]; then
            line "decision: overdue (>${DEADLINE_H}h) — warning now, forcing on the next tick"
            notify "Forcing reboot of $(hostname) in ~15 min" \
                "Reboot pending since $(fmt_ts "$since") (> ${DEADLINE_H}h). Forcing it despite: $(reasons_csv). Veto: touch $HOLD" urgent warning
            [ "$DRY" -eq 1 ] || echo "$NOW" > "$STATE/force-warned"
            return 0
        fi
        if [ $(( NOW - warned )) -lt "$FORCE_GRACE_S" ]; then line "decision: overdue — warned $(( (NOW - warned) / 60 ))m ago, waiting out the grace period"; return 0; fi
        forced=1
        line "decision: overdue and warned — forcing the reboot"
    else
        line "decision: reboot now"
    fi
    [ "$DRY" -eq 1 ] && { dry_reboot_plan; return 0; }
    do_reboot "$since" "$forced"
}

daily_ntfy() {  # since overdue
    local today; today=$(date -d "@$NOW" +%F)
    [ "$(date -d "@$NOW" +%-H)" -ge "$DAILY_HOUR" ] || return 0
    [ "$(cat "$STATE/daily-notified" 2>/dev/null)" = "$today" ] && return 0
    local last why
    last=$(cut -f2- "$STATE/last-blocked" 2>/dev/null)
    why=${last:-$(reasons_csv)}; why=${why:-nothing (the window is $WINDOW)}
    notify "Reboot pending on $(hostname)" \
        "Reboot pending since $(fmt_ts "$1"); blocked by: $why. Next window $WINDOW; forced after ${DEADLINE_H}h unless $HOLD exists." \
        "$( [ "$2" -eq 1 ] && echo high || echo default )" arrows_counterclockwise
    [ "$DRY" -eq 1 ] || echo "$today" > "$STATE/daily-notified"
}

dry_reboot_plan() {
    local flag tmp; flag=$(flag_read); tmp=$(mktemp -d)
    if lameduck_on; then line "would: keep the lameduck drain, restored as ARCHON_RUN_AS=$(ld_get flag_prev) after boot"
    else line "would: save ARCHON_RUN_AS=$flag$( [ "$flag" = drain ] && echo ' (already drain: left as is, restored as drain)' || echo ', set drain')"; fi
    line "would: re-check archon runs, record, ntfy, sync, $( [ "$(reboot_mode)" = cold ] && echo "arm the RTC wake alarm ($RTC_WAKEALARM, +${WAKE_S}s), $POWEROFF_CMD (cold; warm $REBOOT_CMD if the alarm does not arm)" || echo "$REBOOT_CMD" )"
    record_services "$tmp/s" 2>/dev/null; record_sessions "$tmp/c" 2>/dev/null
    line "would restore user services after boot:"; sed 's/^/      - /' "$tmp/s"; [ -s "$tmp/s" ] || line "  (none)"
    line "would resume Claude sessions after boot:"; awk -F'\t' '{printf "      - %s %s in %s (tmux %s:%s %s) %s\n", $1, $2, $3, $4, $5, $6, $7}' "$tmp/c"; [ -s "$tmp/c" ] || line "  (none)"
    rm -rf "$tmp"
}

# reboot_mode — warm|cold (anything else is warm, with a warning).
reboot_mode() {
    case "$MODE" in warm|cold) echo "$MODE" ;; *) echo warm ;; esac
}

# arm_wake — set the RTC wake alarm to now + WAKE_S and check it reads back.
# The sysfs file refuses a new alarm while one is set: clear it first.
WAKE_ARMED=0
arm_wake() {
    local now t rb
    now=$(date +%s); t=$(( now + WAKE_S ))
    if ! { echo 0 > "$RTC_WAKEALARM" && echo "$t" > "$RTC_WAKEALARM"; } 2>/dev/null; then
        log "cold: cannot write $RTC_WAKEALARM"; return 1
    fi
    rb=$(cat "$RTC_WAKEALARM" 2>/dev/null)
    if [[ "$rb" =~ ^[0-9]+$ ]] && [ "$rb" -gt "$now" ]; then
        WAKE_ARMED=1
        log "cold: RTC wake alarm set for $(date -d "@$rb" '+%F %T') (read back from $RTC_WAKEALARM)"
        return 0
    fi
    log "cold: $RTC_WAKEALARM read back '${rb}' after writing $t — not armed"
    echo 0 > "$RTC_WAKEALARM" 2>/dev/null
    return 1
}

do_reboot() {  # since forced
    local flag prev written=0 ld=0
    flag=$(flag_read)
    if [ "$flag" = unknown ]; then log "cannot read $FLAG_FILE — not rebooting"; return 1; fi
    # Under the lameduck the flag is already our drain: the value to put back
    # after boot is the one the lameduck saved.
    prev=$flag
    if lameduck_on; then ld=1; prev=$(ld_get flag_prev); fi
    rm -rf "$STATE/restore"; mkdir -p "$STATE/restore"; chmod 0700 "$STATE/restore"
    # meta before the flag: whatever happens next, the previous value is on disk.
    printf 'boot_id=%s\nat=%s\nflag_prev=%s\nflag_written=%s\nlameduck=%s\nforced=%s\nmode=%s\n' \
        "$(boot_id)" "$NOW" "$prev" "$ld" "$ld" "$2" "$(reboot_mode)" > "$STATE/restore/meta"
    trap 'restore_flag_on_abort' EXIT
    if [ "$ld" -eq 1 ]; then
        # ABORT_FLAG_PREV stays empty: an aborted reboot leaves the lameduck drain
        # in place, and the lameduck puts it back when the window closes.
        log "flag: drain since the lameduck began (was $prev)"
    elif [ "$flag" != drain ]; then
        ABORT_FLAG_PREV="$flag"
        if ! flag_write drain "# Written by $FLAG_MARK before a reboot (was ARCHON_RUN_AS=$flag; put back after boot) — read by ops/cron/lib/run-as.sh"; then
            log "could not set the flag to drain — not rebooting"; return 1
        fi
        written=1; sed -i 's/^flag_written=0/flag_written=1/' "$STATE/restore/meta"
        log "flag: ARCHON_RUN_AS=drain (was $flag)"
    else
        log "flag already drain (set by someone else) — left alone"
    fi
    # A cron tick may have launched a run between the check and the drain.
    if [ "$2" -eq 0 ]; then
        REASONS=""; check_archon "$prev"
        if [ -n "$REASONS" ]; then log "archon became busy after the drain ($(reasons_csv)) — not rebooting"; return 0; fi
    fi
    record_services "$STATE/restore/services.tsv"
    record_sessions "$STATE/restore/sessions.tsv"
    log "recorded $(wc -l < "$STATE/restore/services.tsv") user service(s), $(wc -l < "$STATE/restore/sessions.tsv") Claude session(s)"
    local svc ses
    svc=$(cut -f1 "$STATE/restore/services.tsv" | paste -sd' '); ses=$(cut -f3 "$STATE/restore/sessions.tsv" | xargs -r -n1 basename | paste -sd' ')
    notify "Rebooting $(hostname)$( [ "$2" -eq 1 ] && echo ' (forced, deadline)')$( [ "$(reboot_mode)" = cold ] && echo ' (cold: power off + RTC wake)')" \
        "Reboot pending since $(fmt_ts "$1"). Will restore: flag=$prev; services: ${svc:-none}; Claude sessions: ${ses:-none}." default arrows_counterclockwise
    log "sync (up to ${SYNC_TIMEOUT}s)"
    timeout "$SYNC_TIMEOUT" sync || log "WARNING: sync did not finish in ${SYNC_TIMEOUT}s — rebooting anyway"
    trap - EXIT; ABORT_FLAG_PREV=""
    local cmd="$REBOOT_CMD" what="rebooting"
    case "$MODE" in warm) ;; cold)
        if arm_wake; then cmd="$POWEROFF_CMD"; what="powering off for a cold boot (RTC wake in ~${WAKE_S}s)"
        else log "WARNING: cold mode: the RTC wake alarm could not be armed — falling back to a warm reboot"; fi ;;
        *) log "WARNING: SAFE_REBOOT_MODE=$MODE is neither warm nor cold — rebooting warm" ;;
    esac
    sed -i "s/^mode=.*/mode=$( [ "$cmd" = "$POWEROFF_CMD" ] && [ "$WAKE_ARMED" -eq 1 ] && echo cold || echo warm )/" "$STATE/restore/meta"
    log "$what: $cmd"
    # shellcheck disable=SC2086  # a command line by design
    if ! $cmd; then
        [ "$WAKE_ARMED" -eq 1 ] && { echo 0 > "$RTC_WAKEALARM"; } 2>/dev/null
        ABORT_FLAG_PREV=$( [ "$written" -eq 1 ] && echo "$flag" ); restore_flag_on_abort
        notify "Reboot FAILED on $(hostname)" "$cmd failed; $( [ "$ld" -eq 1 ] && echo 'the lameduck drain stays until the window closes' || echo 'flag put back'). journalctl -u safe-reboot.service" high warning
        return 1
    fi
    return 0
}

# ----------------------------------------------------------- the restore ----
serve_code() { curl -s -o /dev/null --max-time 5 -w '%{http_code}' "$SERVE_URL" 2>/dev/null || true; }

cmd_restore() {
    [ "$DRY" -eq 1 ] || [ "$IS_ROOT" -eq 1 ] || [ -n "${SAFE_REBOOT_TEST:-}" ] || { echo "restore needs root (or: $TOOL restore --dry-run)" >&2; exit 1; }
    local meta="$STATE/restore/meta"
    [ "$DRY" -eq 1 ] || rm -f "$STATE/pending-since" "$STATE/force-warned" "$STATE/daily-notified" "$STATE/last-blocked"
    if [ ! -r "$meta" ]; then
        log "nothing recorded — not a safe-reboot reboot"
        # A boot the gate did not cause, in the middle of a lameduck: undo it
        # (the gate drains again if the reboot is still pending and due).
        lameduck_end "host rebooted outside the gate"
        return 0
    fi
    local prev written same_boot=0 i st
    prev=$(sed -n 's/^flag_prev=//p' "$meta"); written=$(sed -n 's/^flag_written=//p' "$meta")
    grep -qx "boot_id=$(boot_id)" "$meta" && same_boot=1
    log "restoring state recorded $(fmt_ts "$(sed -n 's/^at=//p' "$meta")") (flag was $prev)"

    # 1. the user manager (lingering) must be up before anything of the owner's.
    if [ "$DRY" -eq 0 ]; then
        for ((i = 0; i < WAIT_S; i += 2)); do
            st=$(owner_systemctl is-system-running 2>/dev/null || true)
            case "$st" in running|degraded) break ;; esac
            sleep 2
        done
        log "owner's user manager: ${st:-unreachable}"
    fi

    # 2. archon-serve: system unit after the cutover, the owner's user unit before.
    local serve="" code
    if [ "$prev" = archon ]; then
        if [ "$DRY" -eq 1 ]; then line "would: systemctl start $SERVE_UNIT (system unit, User=$FACTORY_USER)"
        else systemctl is-active -q "$SERVE_UNIT" || systemctl start "$SERVE_UNIT" || log "WARNING: systemctl start $SERVE_UNIT failed"; fi
        serve="system $SERVE_UNIT"
    else
        if [ "$DRY" -eq 1 ]; then line "would: systemctl --user -M $OWNER@ start $SERVE_UNIT"
        else owner_systemctl is-active -q "$SERVE_UNIT" || owner_systemctl start "$SERVE_UNIT" || log "WARNING: user $SERVE_UNIT start failed"; fi
        serve="$OWNER's user $SERVE_UNIT"
    fi
    code=""
    if [ "$DRY" -eq 0 ]; then
        for ((i = 0; i < WAIT_S; i += 2)); do code=$(serve_code); [ "$code" = 200 ] && break; sleep 2; done
        log "$serve: $SERVE_URL answers ${code:-nothing}"
    fi

    # 3. the flag, only if it is still the drain we wrote (the owner may have
    #    changed it by hand since).
    local flagmsg="flag left alone (was already drain)"
    if [ "$written" = 1 ]; then
        if [ "$(flag_read)" = drain ] && flag_ours; then
            if [ "$DRY" -eq 1 ]; then flagmsg="would put ARCHON_RUN_AS=$prev back"
            elif flag_write "$prev" "# Written by $FLAG_MARK restore after a reboot — read by ops/cron/lib/run-as.sh"; then flagmsg="flag back to $prev"
            else flagmsg="FAILED to put the flag back to $prev"; fi
        else flagmsg="flag changed by hand since ($(flag_read)) — left alone"; fi
    fi
    log "$flagmsg"
    [ "$DRY" -eq 1 ] || rm -f "$LD_FILE" "$STATE/lameduck-notified"   # meta carried the lameduck's flag_prev

    # 4. user services (--no-block: the NAS mirror runs for hours).
    local restored=() u how tgt
    if [ "$same_boot" -eq 0 ] && [ -r "$STATE/restore/services.tsv" ]; then
        while IFS=$'\t' read -r u how tgt; do
            [ -n "$u" ] || continue
            if [ "$DRY" -eq 1 ]; then line "would start $tgt ($how, was $u)"; continue; fi
            if [ "$how" = runtime ]; then
                local rdir; rdir="/run/user/$(id -u "$OWNER")/systemd/user"
                # shellcheck disable=SC2016
                as_user "$OWNER" sh -c 'mkdir -p "$1" && cat > "$1/$2"' sh "$rdir" "$tgt" < "$STATE/restore/unit.$u" \
                    && owner_systemctl daemon-reload
            fi
            owner_systemctl reset-failed "$tgt" 2>/dev/null
            if owner_systemctl start --no-block "$tgt"; then restored+=("$tgt"); else log "WARNING: could not start $tgt"; fi
        done < "$STATE/restore/services.tsv"
    fi

    # 5. Claude sessions: one tmux window each, `claude --resume <id>` typed into
    #    a login shell (so the pane survives claude exiting), idle at the prompt.
    local sessions=() user sid cwd ts _widx wname flags first unit
    if [ "$same_boot" -eq 0 ] && [ -r "$STATE/restore/sessions.tsv" ]; then
        while IFS=$'\t' read -r user sid cwd ts _widx wname flags; do
            [ "$flags" = - ] && flags=""
            [ -n "$sid" ] && [ "$user" = "$OWNER" ] || continue
            # --resume looks the session up by project directory: without it, skip.
            if [ ! -d "$cwd" ]; then log "WARNING: $cwd is gone — not resuming $sid"; continue; fi
            [[ "$sid" =~ ^[0-9a-f-]+$ ]] || continue
            local cmd="unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SSE_PORT; claude --resume $sid${flags:+ $flags}"
            if [ "$DRY" -eq 1 ]; then line "would resume in tmux $ts ($wname) at $cwd: $cmd"; continue; fi
            if owner_tmux has-session -t "=$ts" 2>/dev/null; then
                owner_tmux new-window -d -t "=$ts:" -n "$wname" -c "$cwd"
            else
                # The first tmux server must live in the owner's user manager,
                # not in this oneshot's cgroup (which is killed when it exits).
                unit="safe-reboot-tmux-$(tr -c 'A-Za-z0-9\n' '-' <<<"$ts")-$(date +%s)"
                if [ "$IS_ROOT" -eq 1 ]; then set -- -M "$OWNER@"; else set --; fi
                systemd-run --user "$@" --quiet --collect --unit="$unit" -p Type=forking \
                    /usr/bin/tmux new-session -d -s "$ts" -n "$wname" -c "$cwd"
            fi
            first=$(owner_tmux list-windows -t "=$ts" -F '#{window_index} #{window_name}' 2>/dev/null | awk -v n="$wname" '$2 == n {w = $1} END {print w}')
            if [ -n "$first" ] && owner_tmux send-keys -t "=$ts:$first" "$cmd" Enter; then
                sessions+=("$ts:$wname ($(basename "$cwd"))")
            else log "WARNING: could not start tmux window for session $sid"; fi
        done < "$STATE/restore/sessions.tsv"
    fi

    # 6. health summary.
    local health=() failed_sys failed_usr freeroot
    code=$(serve_code); health+=("archon-serve ${code:-down}")
    health+=("flag $(flag_read)")
    failed_sys=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd' ')
    failed_usr=$(owner_systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd' ')
    health+=("failed units: ${failed_sys:-none}${failed_usr:+; user: $failed_usr}")
    freeroot=$(df -Pm / | awk 'NR == 2 {print int($4 / 1024) "G"}'); health+=("/ free $freeroot")
    if [ "$prev" = archon ] && [ "$DRY" -eq 0 ] && [ -x "$REPO/ops/host/archon-user/verify.sh" ]; then
        local v; v=$(cd / && timeout 300 runuser -u "$OWNER" -- "$REPO/ops/host/archon-user/verify.sh" 2>&1)
        health+=("verify.sh $(grep -c PASS <<<"$v") PASS / $(grep -c FAIL <<<"$v") FAIL")
    fi
    local summary
    summary="Back up after reboot. $flagmsg; restored services: ${restored[*]:-none}; Claude sessions: ${sessions[*]:-none}. Health: $(printf '%s; ' "${health[@]}" | sed 's/; $//')."
    log "$summary"
    local prio=default
    { [ "${code:-}" != 200 ] || [ -n "$failed_sys$failed_usr" ]; } && prio=high
    notify "$(hostname) back up after reboot" "$summary" "$prio" white_check_mark
    if [ "$DRY" -eq 0 ]; then rm -rf "$STATE/restored.last"; mv "$STATE/restore" "$STATE/restored.last"; fi
    return 0
}

# ------------------------------------------------------------------ main ----
case "${1:-}" in
    status|--dry-run|-n) DRY=1; log "status (dry-run: nothing is changed, no ntfy is sent)"; cmd_gate ;;
    gate) cmd_gate ;;
    restore) [ "${2:-}" = --dry-run ] && DRY=1; cmd_restore ;;
    -h|--help) sed -n '2,76p' "$0" ;;
    *) echo "usage: $TOOL status|gate|restore [--dry-run]" >&2; exit 2 ;;
esac
