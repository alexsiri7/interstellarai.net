#!/usr/bin/env bash
# `archon` for the owner's side once ARCHON_RUN_AS is drain or archon (see
# ../run-as.sh). lib/run-as.sh puts this directory first on PATH for the cron
# scripts, and install.sh --cutover points ~/.bun/bin/archon here so a manual
# `archon ...` by the owner cannot start a second, stale factory as asiri.
#
#   archon mode: exec sudo -n -u archon /usr/local/bin/archon-as-archon "$@"
#                (the wrapper validates the arguments and maps the directory)
#   drain mode:  `workflow run` is refused (exit 75); anything else runs the
#                real CLI as asiri so the runs in flight can finish
#   asiri mode:  the real CLI as asiri (only reached when ~/.bun/bin/archon
#                still points here after a rollback that skipped the symlink)
#
# `exec`, so the pid a caller records ($!) is the sudo process, whose argv
# (".../archon-as-archon workflow run <name> ...") the pgrep guards match.
set -u
mode="${ARCHON_RUN_AS:-}"
if [ -z "$mode" ]; then
    f="${ARCHON_RUN_AS_FILE:-$HOME/.config/archon-cron/run-as}"
    [ -r "$f" ] && mode=$(sed -nE 's/^[[:space:]]*ARCHON_RUN_AS=["'\'']?([a-z]+)["'\'']?[[:space:]]*(#.*)?$/\1/p' "$f" | tail -n 1)
fi
real="${ARCHON_REAL_BIN:-/mnt/ext-fast/archon/packages/cli/src/cli.ts}"
# Every cron launch goes through here, so this is the one gate no launch site
# can miss: while the Claude account is rate limited (lib/quota-pause.sh)
# `workflow run` is refused like a drain (exit 75). The launching scripts check
# quota_may_launch themselves first; this catches the rest (pipeline-health's
# fixers). While held, a run main may take (lib/main-account.sh) goes to the
# wrapper as --account main. With the owner's LACHESIS_ROUTE switch on, the
# account is the one Lachesis route_run names for the workflow's kind of work
# (lib/quota-pause.sh quota_route_account). Every run let through is recorded
# with its account (quota_record_launch), so its rate-limit errors hold only
# that account and lachesis-report reports its usage on it.
# ARCHON_QUOTA_OVERRIDE=1 lets the owner start a run by hand anyway.
if [ "$mode" = archon ] && [ "${1:-}" = workflow ] && [ "${2:-}" = run ] \
        && [ "${ARCHON_QUOTA_OVERRIDE:-}" != 1 ]; then
    shim_lib="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
    if ARCHON_RUN_AS=archon source "$shim_lib/ship-breaker.sh" 2>/dev/null \
            && source "$shim_lib/quota-pause.sh" 2>/dev/null; then
        # In this shell, not a $(...): QUOTA_ACCOUNT must survive the call.
        held_log=$(mktemp 2>/dev/null || echo "/tmp/archon-shim.$$")
        # shellcheck source=/dev/null
        source "$shim_lib/lachesis.sh" 2>/dev/null || true
        QUOTA_RUN_KIND=$(lachesis_kind_for "${3:-}" 2>/dev/null || echo implementation)
        export QUOTA_RUN_KIND
        rc=0; ARCHON_RUN_AS=archon quota_launch_account "archon workflow run" >"$held_log" || rc=$?
        held=$(cat "$held_log" 2>/dev/null); rm -f "$held_log"
        if [ "$rc" != 0 ]; then
            held="${held##*$'\n'}"
            echo "archon: refusing 'workflow run' — ${held#*: }" >&2
            exit 75
        fi
        # Not held and not routed: no output, the factory runs it. Held and
        # main took it, or routed: its one log line.
        [ -n "$held" ] && echo "$held" >&2
        quota_record_launch "$QUOTA_ACCOUNT" "${3:-}" "${4:-}"
        [ "$QUOTA_ACCOUNT" = factory ] || set -- --account "$QUOTA_ACCOUNT" "$@"
    fi
fi
case "$mode" in
    archon)
        exec sudo -n -u "${ARCHON_AS_USER:-archon}" "${ARCHON_AS_WRAPPER:-/usr/local/bin/archon-as-archon}" "$@" ;;
    drain)
        if [ "${1:-}" = workflow ] && [ "${2:-}" = run ]; then
            echo "archon: refusing 'workflow run' — factory is draining for the archon-user cutover (ARCHON_RUN_AS=drain)" >&2
            exit 75
        fi
        exec "$real" "$@" ;;
    *)
        exec "$real" "$@" ;;
esac
