---
import Layout from "../layouts/Layout.astro";
import { projects, shapeGroups } from "../data/projects";
---

<Layout
  title="Projects · InterStellar AI"
  description="The InterStellar AI portfolio: FilmDuel, Kindred, Reli, Word Coach Annie, Lachesis, Cosmic Match and The Un-Reminder — with the stack and deploy target behind each one."
>
  <section class="pf-hero">
    <div class="wrap">
      <h1>The <em>portfolio</em></h1>
      <p class="lede">The portfolio at a glance. For deploy and hosting defaults, see <a href="/mementos/003-per-project-deploy-targets">ADR-003</a>. Each project's own repo documents its specifics.</p>
    </div>
  </section>
  <section class="pf-body">
    <div class="wrap">
      {shapeGroups.map((group) => (
        <div class="pf-shape-group">
          <div class="pf-shape-head">
            <h2>{group.title}</h2>
            <span class="pf-shape-meta eyebrow">{group.meta}</span>
          </div>
          <div class="pf-list-row">
            {projects.filter((p) => p.shape === group.shape).map((p) => {
              const Row = p.href ? "a" : "div";
              return (
                <Row class="pf-row" href={p.href}>
                  <span class="name">{p.namePre}{p.nameEm && <em>{p.nameEm}</em>}{p.namePost}</span>
                  <span class="desc">{p.desc}</span>
                  <span class="stack">{p.stack}</span>
                  <span class="status"><span class={`badge badge-${p.status}`}>{p.status}</span></span>
                </Row>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
